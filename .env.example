# Copy to .env.local for local development, or add these in Vercel:
# Project Settings > Environment Variables. Never commit real values.

# Square access token. Leave empty to use the built-in demo products.
SQUARE_ACCESS_TOKEN=

# "production" for the live store, "sandbox" for Square's test account.
SQUARE_ENVIRONMENT=production

# Optional: only count stock at this location (Square Dashboard > Account & Settings > Locations).
SQUARE_LOCATION_ID=

# Which products appear on the website (all optional).
# Only show items in this Square category, e.g. Online. Empty shows everything.
SQUARE_ONLINE_CATEGORY=
# Hide items in these Square categories, e.g. Cigarettes,Snacks,Lottery
SQUARE_HIDDEN_CATEGORIES=
# Set to true to remove sold-out items instead of showing them as "Sold out".
SQUARE_HIDE_SOLD_OUT=

# ---- Card payments (Square Web Payments) ----
# Kept separate from SQUARE_ACCESS_TOKEN above so the catalogue can be read from the live account
# while test payments go to the sandbox one. Point all of these at production values to go live.
SQUARE_PAYMENTS_ENVIRONMENT=sandbox
SQUARE_PAYMENTS_ACCESS_TOKEN=
SQUARE_PAYMENTS_LOCATION_ID=

# Public: the browser needs these to render Square's hosted card fields.
# Sandbox application ids start with "sandbox-sq0idb-", production ones with "sq0idp-".
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_PAYMENTS_ENVIRONMENT=sandbox

# ---- Sign in (NextAuth) ----
# Signs the session cookie. Needed for every sign-in method. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The site's own URL. Required in production (https://alcohauls.vercel.app); inferred locally.
NEXTAUTH_URL=http://localhost:3000

# Google: an OAuth 2.0 Client ID (Web application) from Google Cloud Console > Google Auth Platform.
# Authorised redirect URIs: http://localhost:3000/api/auth/callback/google
#                           https://alcohauls.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: needs a paid Apple Developer account, and only works on the https site, never localhost.
# developer.apple.com > Certificates, IDs & Profiles:
#   APPLE_ID           the Services ID's identifier, e.g. app.alcohauls.signin
#                      Return URL: https://alcohauls.vercel.app/api/auth/callback/apple
#   APPLE_TEAM_ID      the 10-character Team ID, top right of the developer site
#   APPLE_KEY_ID       the Key ID of a key with "Sign in with Apple" enabled
#   APPLE_PRIVATE_KEY  that key's .p8 file contents, on one line with \n for each line break
APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email: sends a sign-in link, no password. Locally, with these empty, the link is printed in the
# terminal instead. In production email sign-in stays off until both are set.
# Resend (resend.com) > API Keys. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Noma Wine & Liquor <signin@yourdomain.com>"

# ---- Delivery address check (USPS) ----
# developers.usps.com > Apps > Add App, with the Addresses API. Empty means addresses are taken as
# typed. "testing" uses USPS's test environment.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_ENVIRONMENT=production
