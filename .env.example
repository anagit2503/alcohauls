# Copy to .env.local for local development, or add these in Vercel:
# Project Settings > Environment Variables. Never commit real values.

# Square access token. Leave empty to use the built-in demo products.
SQUARE_ACCESS_TOKEN=

# "production" for the live store, "sandbox" for Square's test account.
SQUARE_ENVIRONMENT=production

# Optional: only count stock at this location (Square Dashboard > Account & Settings > Locations).
SQUARE_LOCATION_ID=

# Which products appear on the website (all optional).
# Only show items in this Square category, e.g. Online. Empty shows everything.
SQUARE_ONLINE_CATEGORY=
# Hide items in these Square categories, e.g. Cigarettes,Snacks,Lottery
SQUARE_HIDDEN_CATEGORIES=
# Set to true to remove sold-out items instead of showing them as "Sold out".
SQUARE_HIDE_SOLD_OUT=

# ---- Card payments (Square Web Payments) ----
# Kept separate from SQUARE_ACCESS_TOKEN above so the catalogue can be read from the live account
# while test payments go to the sandbox one. Point all of these at production values to go live.
SQUARE_PAYMENTS_ENVIRONMENT=sandbox
SQUARE_PAYMENTS_ACCESS_TOKEN=
SQUARE_PAYMENTS_LOCATION_ID=

# Public: the browser needs these to render Square's hosted card fields.
# Sandbox application ids start with "sandbox-sq0idb-", production ones with "sq0idp-".
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_PAYMENTS_ENVIRONMENT=sandbox

# ---- Sign in with Google (NextAuth) ----
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application).
# Authorised redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google      (local)
#   https://YOUR-DOMAIN/api/auth/callback/google        (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The site's own URL. Required in production; inferred locally.
NEXTAUTH_URL=http://localhost:3000
